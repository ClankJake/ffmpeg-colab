#!/bin/bash
# Instala o FFmpeg estático no Google Colab.
# Uso: bash install            (versão padrão)
#      FFMPEG_VERSION=8.1.3 bash install
set -eu

FFMPEG_VERSION="${FFMPEG_VERSION:-9.0.2}"
REPO="${FFMPEG_REPO:-ClankJake/ffmpeg-colab}"
URL="https://github.com/${REPO}/releases/download/${FFMPEG_VERSION}/ffmpeg"

if command -v curl >/dev/null 2>&1; then
    DL() { curl -fL --retry 3 -o "$1" "$URL"; }
elif command -v wget >/dev/null 2>&1; then
    DL() { wget -q --tries=3 "$URL" -O "$1"; }
else
    echo "Please install either wget or curl"
    exit 1
fi

# `which` retorna erro quando não acha nada; com `set -e` isso abortaria o script
FFMPEGLOC="$(command -v ffmpeg || true)"
if [ -n "$FFMPEGLOC" ]; then
    echo "FFmpeg was found at $FFMPEGLOC"
    echo "Removing old FFmpeg"
    rm -f "$FFMPEGLOC"
fi

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

echo "Downloading FFmpeg ${FFMPEG_VERSION}"
if ! DL "$TMP"; then
    echo "Download failed: $URL"
    exit 1
fi
chmod +x "$TMP"

for DEST in /usr/bin /usr/local/bin; do
    if mv "$TMP" "$DEST/ffmpeg" 2>/dev/null; then
        echo "FFmpeg was successfully installed to $DEST"
        ffmpeg -version | head -n 1
        exit 0
    fi
    echo "Failed to move ffmpeg to $DEST"
done
echo "Installation failed. Please check your permissions"
exit 1
